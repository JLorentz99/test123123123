# Data are local or managed by a dedicated data store.
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated outputs are reproducible and ignored by default.
/results/figures/*
!/results/figures/.gitkeep
/results/tables/*
!/results/tables/.gitkeep

# Common large bioinformatics formats. Remove a pattern only after deciding
# that Git is the correct storage mechanism for that file type.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.sam
*.bcf
*.vcf.gz
*.vcf.bgz
*.tbi
*.csi
*.bigWig
*.bw
*.bed.gz
*.h5
*.h5ad
*.loom
